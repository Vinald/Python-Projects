# Example .env file for WebScrapping/script.py
# Copy this file to `.env` and fill the real values. Do NOT commit your real `.env` to public repos.

# SMTP server settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Email addresses
EMAIL_FROM=your@example.com
EMAIL_TO=recipient@example.com

# App password or account password (use an app password for Gmail)
EMAIL_PASSWORD=your_app_password
